# Copy to .env (never commit .env) and fill in values.
# Import works with all model keys empty: import never calls providers.
# Audits additionally require VCC_INFERENCE_ENABLED=1 plus provider keys.
DJANGO_SECRET_KEY=
VCC_RUNTIME_DIR=
VCC_DEBUG=
BASETEN_API_KEY=
META_API_KEY=
# --- Audit engine (PR #2) ---
# Master switch for queueing audits AND live provider calls.
VCC_INFERENCE_ENABLED=
# Per-job model-call allowance (local stages never consume it).
VCC_AUDIT_MAX_CALLS=
# Per-job spend ceiling, USD (default 2.00).
VCC_AUDIT_SPEND_CAP_USD=
# Worst-case spend headroom reserved before each provider call (default 0.50).
# Must upper-bound one call's plausible cost (retries included).
VCC_AUDIT_RESERVE_PER_CALL=
# Derived-evidence bounds per job.
VCC_AUDIT_MAX_CROPS=
VCC_AUDIT_MAX_RECHECKS=
# Worker lease: a RUNNING job with an older heartbeat is reclaimed (seconds).
VCC_AUDIT_HEARTBEAT_S=
# Model identifiers (defaults shown).
VCC_BASETEN_MODEL=meta-models/muse-spark-open-1026
VCC_SAM_MODEL=sam-3.1
# Live gates (tests + evals): set to 1 WITH keys to spend real credits.
# Never set in CI.
VCC_LIVE_SMOKE=
