root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{ts,js,svelte,json}]
indent_style = space
indent_size = 2
quote_type = single

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
